# ==========================================
# JI-DOOR E-COMMERCE - Environment Template
# Copy this file to .env and adjust values
# ==========================================

# --- Application ---
CI_ENVIRONMENT = development

# --- Database MySQL (MAMP) ---
DB_HOST = 127.0.0.1
DB_PORT = 8889
DB_USER = root
DB_PASSWORD =
DB_NAME = ecommerce_db
DB_CHARSET = utf8mb4

# --- Python Recommendation API (FastAPI) ---
PY_API_HOST = 127.0.0.1
PY_API_PORT = 8000
PY_API_BASE_URL = http://127.0.0.1:8000

# --- Uploads ---
UPLOAD_PATH = uploads/

# --- Midtrans Snap ---
# Sandbox: dashboard.sandbox.midtrans.com -> Settings -> Access Keys
# Produksi: dashboard.midtrans.com (akun harus sudah terverifikasi)
MIDTRANS_SERVER_KEY = SB-MidServer-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY = SB-MidClient-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION = false
