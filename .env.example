# ==========================================
# JI-DOOR E-COMMERCE - Environment Template
# Copy this file to .env and adjust values
# ==========================================

# --- Application ---
CI_ENVIRONMENT = development

# --- Database MySQL (MAMP) ---
DB_HOST = 127.0.0.1
DB_PORT = 8889
DB_USER = root
DB_PASSWORD =
DB_NAME = ecommerce_db
DB_CHARSET = utf8mb4

# --- Python Recommendation API (FastAPI) ---
PY_API_HOST = 127.0.0.1
PY_API_PORT = 8000
PY_API_BASE_URL = http://127.0.0.1:8000

# --- Uploads ---
UPLOAD_PATH = uploads/
